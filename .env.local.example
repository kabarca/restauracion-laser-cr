# Resend (https://resend.com) — used by api/contact and api/franchise-application.
# Leave RESEND_API_KEY empty during local dev; the routes fail gracefully with a
# Spanish error message instead of crashing when it's unset.
RESEND_API_KEY=

# Defaults to Resend's shared test sender until a custom domain is verified.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives contact and franchise-application submissions.
CONTACT_TO_EMAIL=onboarding@resend.dev

# GA4 measurement ID. Optional — defaults to the production property in
# lib/site-config.ts. Analytics only loads in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
