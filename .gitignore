# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# planning docs (working notes, not project deliverables — see docs/ for those)
/planning/

# claude code local settings and downloaded skills (reinstallable via skills-lock.json / npx skills@latest)
.claude/settings.local.json
/.claude/skills/
/.agents/

# local-only image generation tool (kie.ai) — images are generated on the dev
# machine, never at deploy time. its requirements.txt makes host build systems
# auto-detect a python project and run a python build, which breaks deploys.
/tools/

# python
**/.env
__pycache__/
*.pyc

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
